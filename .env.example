# Copy to .env and fill in. Never commit .env.
# In GitHub Actions these are provided as repository secrets/variables instead.

# --- Notion (https://www.notion.so/profile/integrations -> internal integration secret) ---
NOTION_TOKEN=ntn_xxx
# 32-char IDs from the database URLs: notion.so/<workspace>/<DATABASE_ID>?v=...
HIGHLIGHTS_DATABASE_ID=
LIBRARY_DATABASE_ID=

# --- Property names (case-sensitive, must match Notion exactly) ---
PROP_HIGHLIGHT_NAME=name          # title: condensed highlight
PROP_HIGHLIGHT_KEYWORDS=keywords  # multi-select
PROP_HIGHLIGHT_FAVORITE=favorite  # checkbox
PROP_HIGHLIGHT_PAGE=page          # number
PROP_HIGHLIGHT_SOURCE=source      # relation -> Library
PROP_BOOK_NAME=Name               # title in Library

# --- Review history encryption (generate with: uv run feeder keygen) ---
STATE_KEY=

# --- Digest ---
DIGEST_SIZE=5
FAVORITE_WEIGHT=3.0     # favorites are this many times more likely to be picked
COOLDOWN_DAYS=60        # don't repeat a highlight within this many days
MAX_PER_BOOK=2          # max highlights from the same book per digest
TIMEZONE=Europe/Amsterdam
SEND_TIME=07:30

# --- Email (Gmail: enable 2-Step Verification, then create an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcdabcdabcdabcd  # 16-char App Password, no spaces
EMAIL_FROM=
EMAIL_TO=you@gmail.com
