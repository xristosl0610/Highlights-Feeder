# Copy to .env and fill in. Never commit .env.
# Secrets only: non-secret settings live in feeder.toml (committed).
# In GitHub Actions these are provided as repository secrets instead.

# --- Notion (https://www.notion.so/profile/integrations -> internal integration secret) ---
NOTION_TOKEN=ntn_xxx
# 32-char IDs from the database URLs: notion.so/<workspace>/<DATABASE_ID>?v=...
HIGHLIGHTS_DATABASE_ID=
LIBRARY_DATABASE_ID=

# --- Review history encryption (generate with: uv run feeder keygen) ---
STATE_KEY=

# --- Email (Gmail: enable 2-Step Verification, then create an App Password) ---
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcdabcdabcdabcd  # 16-char App Password, no spaces
EMAIL_FROM=
EMAIL_TO=you@gmail.com
