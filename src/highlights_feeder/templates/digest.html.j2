<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f1ea;font-family:Georgia,'Times New Roman',serif;color:#2b2b2b;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f1ea;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;">
          <tr>
            <td style="padding:0 8px 16px;">
              <h1 style="margin:0;font-size:22px;font-weight:normal;">Your daily highlights</h1>
              <p style="margin:4px 0 0;font-size:13px;color:#8a8170;font-family:Arial,sans-serif;">{{ day.strftime('%A %d %B %Y') }}</p>
            </td>
          </tr>
          {% for h in highlights %}
          <tr>
            <td style="background:#ffffff;border-radius:8px;padding:20px 24px;{% if h.favorite %}border-left:4px solid #d4a017;{% endif %}">
              <p style="margin:0 0 12px;font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:#8a8170;font-family:Arial,sans-serif;">
                {{ h.book_name or 'Unknown source' }}{% if h.page %} &middot; p. {{ h.page }}{% endif %}{% if h.favorite %} &middot; &#9733;{% endif %}
              </p>
              <h2 style="margin:0 0 12px;font-size:18px;line-height:1.4;font-weight:bold;">{{ h.name }}</h2>
              {% for block in h.body %}
                {% set bg = block.get('color') | color_css %}
                {% if block.type == 'quote' %}
              <blockquote style="margin:0 0 12px;padding:4px 0 4px 14px;border-left:3px solid #d8d0bf;font-size:16px;line-height:1.6;font-style:italic;{{ bg }}">{{ block | rich }}</blockquote>
                {% elif block.type in ('bulleted_list_item', 'numbered_list_item', 'to_do') %}
              <p style="margin:0 0 6px;font-size:16px;line-height:1.6;{{ bg }}">&bull; {{ block | rich }}</p>
                {% elif block.type.startswith('heading') %}
              <p style="margin:0 0 8px;font-size:16px;font-weight:bold;{{ bg }}">{{ block | rich }}</p>
                {% elif block.type == 'callout' %}
              <p style="margin:0 0 12px;padding:10px 12px;background:#faf7f0;border-radius:6px;font-size:15px;line-height:1.6;{{ bg }}">{{ block | rich }}</p>
                {% else %}
              <p style="margin:0 0 12px;font-size:16px;line-height:1.6;{{ bg }}">{{ block | rich }}</p>
                {% endif %}
              {% endfor %}
              {% if h.keywords or h.url %}
              <p style="margin:12px 0 0;font-size:12px;color:#8a8170;font-family:Arial,sans-serif;">
                {% for k in h.keywords %}<span style="display:inline-block;margin:0 4px 4px 0;padding:2px 8px;background:#f0ebe0;border-radius:10px;">{{ k }}</span>{% endfor %}
                {% if h.url %}<a href="{{ h.url }}" style="color:#8a8170;">Open in Notion</a>{% endif %}
              </p>
              {% endif %}
            </td>
          </tr>
          <tr><td style="height:16px;"></td></tr>
          {% endfor %}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
